# 后端地址
API_BASE_URL=http://localhost:8000

# 用户密钥
SECRET_KEY=the_key_from_green-tracker.cn

# ============================================================
#  MQTT 配置（设备端）
# ============================================================
MQTT_DEVICE_ID=your-device-id
MQTT_DEVICE_SECRET=your-device-secret-key
MQTT_BROKER_HOST=green-tracker.cn
MQTT_BROKER_PORT=1883
MQTT_STATUS_INTERVAL=30

# ============================================================
#  云端签到（能力开关来源）
# ============================================================
# 签到间隔（秒），建议 5~10 分钟
DEVICE_HEARTBEAT_INTERVAL=300
# 设为 0 可关闭云端签到（离线调试）
GREEN_TRACKER_HEARTBEAT=1

# ============================================================
#  指令启用开关（本地策略文件，优先级最高，压过云端下发的策略）
# ============================================================
# 默认读取 <项目根>/config/command_policy.json，内容形如：
#   {"execute_shell": false, "cloud_probe": true}
# 需要把策略放到仓库之外（只读部署 / 多实例共用）时，用下面的变量覆盖路径
GREEN_TRACKER_COMMAND_POLICY_FILE=
# 设为 0 可整体关闭远程 shell（execute_shell / terminal_reset）
GREEN_TRACKER_ENABLE_SHELL=1
